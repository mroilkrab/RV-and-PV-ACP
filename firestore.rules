rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vouchers collection - read and write access for accounting transactions
    match /vouchers/{voucherId} {
      allow read, write: if true;
    }

    // Settings collection - read and write access for company profile & configurations
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Customers directory collection - read and write access for company client master
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Connection testing document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
